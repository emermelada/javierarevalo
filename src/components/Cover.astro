---
/**
 * Editorial SVG cover for a project — a geometric composition per slug,
 * so cards look designed without needing photography. Replace any of
 * these with a real <img> when project shots/videos exist.
 */
interface Props {
	slug: string;
}
const { slug } = Astro.props;
---

{
	slug === 'smart-desk' ? (
		<svg viewBox="0 0 400 280" role="img" aria-label="Diagram of a standing desk moving between two heights" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<line x1="60" y1="88" x2="240" y2="88" />
				<line x1="90" y1="88" x2="90" y2="220" />
				<line x1="210" y1="88" x2="210" y2="220" />
				<line x1="60" y1="220" x2="240" y2="220" />
			</g>
			<line x1="60" y1="168" x2="240" y2="168" stroke="#141414" stroke-width="3" stroke-dasharray="8 8" />
			<g stroke="#2b3ff2" stroke-width="4" fill="none">
				<line x1="300" y1="200" x2="300" y2="110" />
				<polyline points="282,128 300,108 318,128" />
			</g>
			<circle cx="300" cy="230" r="8" fill="#2b3ff2" />
			<text x="60" y="55" font-family="monospace" font-size="14" fill="#6b675e">fsm://desk/standing</text>
		</svg>
	) : slug === 'mount-stray' ? (
		<svg viewBox="0 0 400 280" role="img" aria-label="Graph of connected rooms forming a procedurally generated map" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<line x1="80" y1="80" x2="180" y2="60" />
				<line x1="180" y1="60" x2="300" y2="100" />
				<line x1="80" y1="80" x2="140" y2="180" />
				<line x1="140" y1="180" x2="240" y2="210" />
				<line x1="240" y1="210" x2="300" y2="100" />
				<line x1="140" y1="180" x2="300" y2="100" />
			</g>
			<g fill="#141414">
				<rect x="66" y="66" width="28" height="28" />
				<rect x="166" y="46" width="28" height="28" />
				<rect x="126" y="166" width="28" height="28" />
			</g>
			<rect x="286" y="86" width="28" height="28" fill="#2b3ff2" />
			<rect x="226" y="196" width="28" height="28" fill="#2b3ff2" />
			<text x="66" y="250" font-family="monospace" font-size="14" fill="#6b675e">seed=Δ new Run()</text>
		</svg>
	) : (
		<svg viewBox="0 0 400 280" role="img" aria-label="Film frames with a play control" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<rect x="60" y="70" width="180" height="120" />
				<rect x="90" y="95" width="180" height="120" />
			</g>
			<rect x="120" y="120" width="180" height="120" fill="#141414" />
			<polygon points="196,160 196,200 232,180" fill="#2b3ff2" />
			<circle cx="330" cy="90" r="20" stroke="#2b3ff2" stroke-width="4" fill="none" />
			<text x="60" y="250" font-family="monospace" font-size="14" fill="#6b675e">48h → production</text>
		</svg>
	)
}
