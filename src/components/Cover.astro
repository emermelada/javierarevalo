---
/**
 * Editorial SVG cover for a project — a geometric composition per slug, so
 * case pages have an image without needing photography. Replace any of these
 * with a real <img> when project shots exist, or set `youtube` in the entry's
 * frontmatter to embed a video instead.
 *
 * Since the home page became a typographic index, these appear only on
 * /work/<slug>/.
 */
interface Props {
	slug: string;
}
const { slug } = Astro.props;
---

{
	slug === 'smart-desk' ? (
		<svg viewBox="0 0 400 280" role="img" aria-label="Diagram of a standing desk moving between two heights" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<line x1="60" y1="88" x2="240" y2="88" />
				<line x1="90" y1="88" x2="90" y2="220" />
				<line x1="210" y1="88" x2="210" y2="220" />
				<line x1="60" y1="220" x2="240" y2="220" />
			</g>
			<line x1="60" y1="168" x2="240" y2="168" stroke="#141414" stroke-width="3" stroke-dasharray="8 8" />
			<g stroke="#2b3ff2" stroke-width="4" fill="none">
				<line x1="300" y1="200" x2="300" y2="110" />
				<polyline points="282,128 300,108 318,128" />
			</g>
			<circle cx="300" cy="230" r="8" fill="#2b3ff2" />
			<text x="60" y="55" font-family="monospace" font-size="14" fill="#6b675e">fsm://desk/standing</text>
		</svg>
	) : slug === 'artcenter' ? (
		<svg viewBox="0 0 400 280" role="img" aria-label="Grid of artwork tiles above a phone outline, linked to a server block" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<rect x="48" y="70" width="70" height="70" />
				<rect x="130" y="70" width="70" height="70" />
				<rect x="48" y="152" width="70" height="70" />
				<rect x="130" y="152" width="70" height="70" />
			</g>
			<rect x="130" y="70" width="70" height="70" fill="#2b3ff2" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<rect x="262" y="60" width="90" height="160" rx="10" />
				<line x1="262" y1="88" x2="352" y2="88" />
			</g>
			<line x1="200" y1="140" x2="262" y2="140" stroke="#2b3ff2" stroke-width="4" stroke-dasharray="10 6" />
			<circle cx="307" cy="190" r="9" fill="#2b3ff2" />
			<text x="48" y="252" font-family="monospace" font-size="14" fill="#6b675e">GET /publicaciones?page=0</text>
		</svg>
	) : slug === 'focusreef' ? (
		<svg viewBox="0 0 400 280" role="img" aria-label="An aquarium whose water level rises with completed focus blocks" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<rect x="60" y="70" width="220" height="160" stroke="#141414" stroke-width="3" fill="none" />
			<line x1="60" y1="130" x2="280" y2="130" stroke="#2b3ff2" stroke-width="4" />
			<g fill="#2b3ff2">
				<polygon points="110,175 150,160 150,190" />
				<polygon points="210,205 178,193 178,217" />
			</g>
			<circle cx="196" cy="160" r="6" stroke="#141414" stroke-width="3" fill="none" />
			<circle cx="216" cy="146" r="4" stroke="#141414" stroke-width="3" fill="none" />
			<g fill="#141414">
				<rect x="312" y="200" width="20" height="30" />
				<rect x="312" y="162" width="20" height="30" />
				<rect x="312" y="124" width="20" height="30" />
			</g>
			<rect x="312" y="86" width="20" height="30" stroke="#141414" stroke-width="3" fill="none" stroke-dasharray="6 5" />
			<text x="60" y="256" font-family="monospace" font-size="14" fill="#6b675e">4 blocks → 4 tokens</text>
		</svg>
	) : (
		<svg viewBox="0 0 400 280" role="img" aria-label="Stacked video frames with a play button" preserveAspectRatio="xMidYMid slice">
			<rect width="400" height="280" fill="#ebe7dc" />
			<g stroke="#141414" stroke-width="3" fill="none">
				<rect x="60" y="70" width="180" height="120" />
				<rect x="90" y="95" width="180" height="120" />
			</g>
			<rect x="120" y="120" width="180" height="120" fill="#141414" />
			<polygon points="196,160 196,200 232,180" fill="#2b3ff2" />
			<circle cx="330" cy="90" r="20" stroke="#2b3ff2" stroke-width="4" fill="none" />
			<text x="60" y="250" font-family="monospace" font-size="14" fill="#6b675e">48h → production</text>
		</svg>
	)
}
