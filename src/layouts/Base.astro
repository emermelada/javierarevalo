---
/**
 * Base layout: the single page shell shared by every route.
 *
 * Owns the document head (SEO/OG metadata, fonts, favicon), the sticky
 * site header, the contact footer, and the only client-side JavaScript
 * on the site (copy-email + scroll reveal, at the bottom of this file).
 *
 * Pages provide their content through the default <slot/> and pass
 * `title`/`description` for the head. The canonical URL is derived from
 * `site` in astro.config.mjs, so it stays correct in every environment.
 */
import '../styles/global.css';

interface Props {
	/** Document title, shown in the tab and in social previews. */
	title: string;
	/** Meta description; also reused as the OG description. */
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/**
 * Link preview image. Absolute by requirement: LinkedIn, Slack and X all
 * reject a relative og:image. Generated from /og-card/ by scripts/make-og.sh,
 * and shared by every page, since the card is about the person rather than
 * the route.
 */
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Javier Arévalo" />
		<meta name="theme-color" content="#f4f1ea" />

		<script is:inline>
			// The reveal animation hides its targets until they scroll into view.
			// That hidden state is claimed here rather than in the stylesheet, and
			// before first paint so nothing flashes: if this script never runs, or
			// the browser has no IntersectionObserver, the page keeps its content
			// visible instead of staying blank.
			if (
				'IntersectionObserver' in window &&
				!matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				document.documentElement.classList.add('js-reveal');
			}
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Javier Arévalo" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Javier Arévalo, software developer, with the address cv.javierarevalo.dev"
		/>
		<!-- Twitter/X needs its own card type to render the image large. -->
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="canonical" href={canonical} />

		<!-- Favicon: monogram tile, inlined to avoid a request. -->
		<link
			rel="icon"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f4f1ea'/%3E%3Ctext x='15' y='23' font-family='Arial,sans-serif' font-size='17' font-weight='900' fill='%23141414' text-anchor='middle'%3EJA%3C/text%3E%3Crect x='25' y='19' width='4' height='4' fill='%232b3ff2'/%3E%3C/svg%3E"
		/>

		<!-- Fonts: Archivo Black (display), Archivo (body), JetBrains Mono (labels). -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="wrap site-header__inner">
				<a class="brand" href="/">Javier<span class="brand__dot">.</span>Arévalo</a>
				<nav class="site-nav" aria-label="Main">
					<a href="/#work">Work</a>
					<a class="nav-link--sm-hide" href="/#experience">Experience</a>
					<a href="/#contact">Contact</a>
					<a class="btn" href="/cv.pdf" download>CV ↓</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="contact" id="contact">
			<div class="wrap">
				<h2 class="contact__title">
					Let's<br />talk<span class="accent-dot">.</span>
				</h2>

				<div class="contact__actions">
					<button class="btn btn--accent" type="button" data-copy-email="javier.arevalo.11111@gmail.com">
						<span data-copy-label>Copy email</span>
					</button>
					<a class="btn" href="mailto:javier.arevalo.11111@gmail.com">Write me <span class="arrow">→</span></a>
					<a class="btn" href="tel:+4550304479">+45 50 30 44 79 <span class="arrow">→</span></a>
					<a class="btn" href="https://www.linkedin.com/in/javier-arevalo-hernandez" rel="noopener">LinkedIn <span class="arrow">→</span></a>
					<a class="btn" href="https://github.com/emermelada" rel="noopener">GitHub <span class="arrow">→</span></a>
					<a class="btn" href="/cv.pdf" download>Download CV (PDF)</a>
				</div>

				<div class="contact__meta">
					<span>© {new Date().getFullYear()} Javier Arévalo</span>
					<span>Vejle, Denmark</span>
					<a href="https://github.com/emermelada/javierarevalo" rel="noopener">Site source</a>
				</div>
			</div>
		</footer>

		<script>
			// All client-side behaviour lives here, as progressive enhancement:
			// the site is fully usable with JavaScript disabled (the copy button
			// degrades to mailto:, and content is simply visible without reveals).

			// Copy-to-clipboard contact button.
			for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
				const label = btn.querySelector('[data-copy-label]');
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copyEmail ?? '');
						if (label) {
							label.textContent = 'Copied ✓';
							setTimeout(() => (label.textContent = 'Copy email'), 1800);
						}
					} catch {
						location.href = `mailto:${btn.dataset.copyEmail}`;
					}
				});
			}

			// Scroll reveal. Runs only if the head script claimed the hidden state,
			// which already checked for reduced motion and IntersectionObserver.
			if (document.documentElement.classList.contains('js-reveal')) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						}
					},
					{ threshold: 0.12 }
				);
				for (const el of document.querySelectorAll('[data-reveal]')) io.observe(el);
			}
		</script>
	</body>
</html>
