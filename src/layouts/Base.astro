---
/**
 * Base layout: the single page shell shared by every route.
 *
 * Owns the document head (SEO/OG metadata, fonts, favicon), the sticky
 * site header, the contact footer, and the only client-side JavaScript
 * on the site (copy-email, at the bottom of this file).
 *
 * Pages provide their content through the default <slot/> and pass
 * `title`/`description` for the head. The canonical URL is derived from
 * `site` in astro.config.mjs, so it stays correct in every environment.
 */
import '../styles/global.css';

interface Props {
	/** Document title, shown in the tab and in social previews. */
	title: string;
	/** Meta description; also reused as the OG description. */
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/**
 * Link preview image. Absolute by requirement: LinkedIn, Slack and X all
 * reject a relative og:image. Generated from /og-card/ by scripts/make-og.sh,
 * and shared by every page, since the card is about the person rather than
 * the route.
 */
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Javier Arévalo" />
		<meta name="theme-color" content="#ffffff" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Javier Arévalo" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Javier Arévalo, software developer, with the address cv.javierarevalo.dev"
		/>
		<!-- Twitter/X needs its own card type to render the image large. -->
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="canonical" href={canonical} />

		<!-- Favicon: monogram tile, inlined to avoid a request. -->
		<link
			rel="icon"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231d5b99' rx='6'/%3E%3Ctext x='16' y='22' font-family='Arial,sans-serif' font-size='15' font-weight='700' fill='%23ffffff' text-anchor='middle'%3EJA%3C/text%3E%3C/svg%3E"
		/>

		<!-- Fonts: IBM Plex Sans (structure, data), Source Serif 4 (reading). -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="wrap site-header__inner">
				<a class="brand" href="/">Javier Arévalo</a>
				<nav class="site-nav" aria-label="Main">
					<a href="/#work">Projects</a>
					<a class="nav-link--sm-hide" href="/#experience">Experience</a>
					<a href="/#contact">Contact</a>
					<a class="btn" href="/cv.pdf" download>CV (PDF)</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="contact" id="contact">
			<div class="wrap">
				<h2 class="contact__title">Get in touch</h2>
				<p class="contact__text">
					Open to student jobs and internships alongside my degree. Email is the fastest way
					to reach me.
				</p>

				<div class="contact__actions">
					<button class="btn btn--accent" type="button" data-copy-email="javier.arevalo.11111@gmail.com">
						<span data-copy-label>Copy email</span>
					</button>
					<a class="btn" href="mailto:javier.arevalo.11111@gmail.com">Write me</a>
					<a class="btn" href="tel:+4550304479">+45 50 30 44 79</a>
					<a class="btn" href="https://www.linkedin.com/in/javier-arevalo-hernandez" rel="noopener">LinkedIn</a>
					<a class="btn" href="https://github.com/emermelada" rel="noopener">GitHub</a>
					<a class="btn" href="/cv.pdf" download>Download CV (PDF)</a>
				</div>

				<div class="contact__meta">
					<span>© {new Date().getFullYear()} Javier Arévalo</span>
					<span>Vejle, Denmark</span>
					<a href="https://github.com/emermelada/javierarevalo" rel="noopener">Site source</a>
				</div>
			</div>
		</footer>

		<script>
			// All client-side behaviour lives here, as progressive enhancement:
			// the site is fully usable with JavaScript disabled (the copy button
			// degrades to mailto:).

			// Copy-to-clipboard contact button.
			for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
				const label = btn.querySelector('[data-copy-label]');
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copyEmail ?? '');
						if (label) {
							label.textContent = 'Copied ✓';
							setTimeout(() => (label.textContent = 'Copy email'), 1800);
						}
					} catch {
						location.href = `mailto:${btn.dataset.copyEmail}`;
					}
				});
			}

		</script>
	</body>
</html>
