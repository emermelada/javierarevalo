---
/**
 * Case-study template — one static page per entry in the `work`
 * collection (/work/<slug>/).
 *
 * Layout: back link → title/tagline → fact columns (role/year/stack)
 * → media slot → markdown body → optional external link → prev/next nav.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
	const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
	// prev/next wrap around so every case links onward; with exactly two
	// entries they collapse to the same target and the nav renders a
	// single "Next case" link instead of a duplicated pair.
	return work.map((entry, i) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: work[i - 1] ?? work[work.length - 1],
			next: work[i + 1] ?? work[0],
		},
	}));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Javier Arévalo`} description={entry.data.summary}>
	<article class="wrap">
		<header class="case-header">
			<a class="case-header__back" href="/#work">← All work</a>
			<h1 class="case-header__title">{entry.data.title}</h1>
			<p class="case-header__tagline">{entry.data.tagline}</p>

			<dl class="case-facts">
				<div>
					<dt>Role</dt>
					<dd>{entry.data.role}</dd>
				</div>
				<div>
					<dt>Year</dt>
					<dd>{entry.data.year}</dd>
				</div>
				<div>
					<dt>Stack</dt>
					<dd>{entry.data.stack.join(' · ')}</dd>
				</div>
				<div>
					<dt>Status</dt>
					<dd>
						<span class={`status status--${entry.data.status}`}>
							<span class="status__dot" aria-hidden="true">●</span>
							{entry.data.status === 'shipped' ? 'Shipped' : 'In progress'}
						</span>
						{entry.data.statusNote && <span class="case-facts__note">{entry.data.statusNote}</span>}
					</dd>
				</div>
			</dl>
		</header>

		<!--
			Media slot.
			- With `youtube: <video id>` in the entry's frontmatter, it embeds the
			  video (privacy-friendly nocookie host, lazy-loaded).
			- Otherwise it shows the editorial SVG cover.
			- For an interactive 3D model (e.g. the desk as a .glb), swap in
			  Google's <model-viewer> web component — no build change needed:

			  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
			  <model-viewer src="/models/desk.glb" alt="3D model of the smart desk"
			      camera-controls auto-rotate loading="lazy"
			      style="width:100%; height:32rem;"></model-viewer>

			  Drop the .glb in public/models/. Gate auto-rotate behind
			  prefers-reduced-motion if it's added globally.
		-->
		<div class="case-media">
			{
				entry.data.youtube ? (
					<iframe
						class="case-media__video"
						src={`https://www.youtube-nocookie.com/embed/${entry.data.youtube}`}
						title={`${entry.data.title} — video`}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				) : (
					<Cover slug={entry.id} />
				)
			}
		</div>

		<div class="case-body">
			<Content />
			{
				entry.data.links.length > 0 && (
					<p class="case-links">
						{entry.data.links.map((link) => (
							<a class="btn btn--accent" href={link.url} rel="noopener">
								{link.label} <span class="arrow">→</span>
							</a>
						))}
					</p>
				)
			}
		</div>

		<nav class="case-nav" aria-label="More work">
			{
				prev.id === next.id ? (
					<a href={`/work/${next.id}/`}>Next case: {next.data.title} →</a>
				) : (
					<>
						<a href={`/work/${prev.id}/`}>← {prev.data.title}</a>
						<a href={`/work/${next.id}/`}>{next.data.title} →</a>
					</>
				)
			}
		</nav>
	</article>
</Base>
