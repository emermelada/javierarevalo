---
/**
 * Case-study template: one static page per entry in the `work`
 * collection (/work/<slug>/).
 *
 * Layout: back link → title → fact columns (role/year/stack/status)
 * → media slot → markdown body → optional external link → prev/next nav.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
	// prev/next wrap around so every case links onward; with exactly two
	// entries they collapse to the same target and the nav renders a
	// single link instead of a duplicated pair.
	return work.map((entry, i) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: work[i - 1] ?? work[work.length - 1],
			next: work[i + 1] ?? work[0],
		},
	}));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
// Phone captures sit side by side; any landscape capture needs the full width.
const shots = entry.data.gallery;
const columns = shots.every((shot) => shot.height > shot.width) ? shots.length : 1;
---

<Base title={`${entry.data.title} · Javier Arévalo`} description={entry.data.summary}>
	<article class="wrap">
		<header class="case-header">
			<a class="case-header__back" href="/#work">← Projects</a>
			<h1 class="case-header__title">{entry.data.title}</h1>

			<dl class="case-facts">
				<div>
					<dt>Role</dt>
					<dd>{entry.data.role}</dd>
				</div>
				<div>
					<dt>Year</dt>
					<dd>{entry.data.year}</dd>
				</div>
				<div>
					<dt>Stack</dt>
					<dd>{entry.data.stack.join(', ')}</dd>
				</div>
				<div>
					<dt>Status</dt>
					<dd>
						<span class={`status status--${entry.data.status}`}>
							<span class="status-dot" aria-hidden="true" />
							{entry.data.status === 'shipped' ? 'Shipped' : 'In progress'}
						</span>
					</dd>
				</div>
			</dl>
		</header>

		<!-- An own clip is a tall phone video: it sits beside the text instead of above it. -->
		<div class={entry.data.video && !entry.data.youtube ? 'case-split' : undefined}>
		<!--
			Media slot. Precedence: embedded video, own clip, real screenshots, then
			nothing. A project with no photograph yet renders no media block at
			all, since an empty space is more honest than a drawing standing in
			for hardware that isn't built.
		-->
		{
			entry.data.youtube ? (
				<div class="case-media">
					<iframe
						class="case-media__video"
						src={`https://www.youtube-nocookie.com/embed/${entry.data.youtube}`}
						title={`${entry.data.title} video`}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				</div>
			) : entry.data.video ? (
				<figure class="case-clip">
					<video
						src={entry.data.video.src}
						poster={entry.data.video.poster}
						width={entry.data.video.width}
						height={entry.data.video.height}
						aria-label={entry.data.video.caption}
						controls
						muted
						loop
						playsinline
						preload="metadata"
					/>
					<figcaption>{entry.data.video.caption}</figcaption>
				</figure>
			) : entry.data.gallery.length > 0 ? (
				<div class="case-gallery" style={`--shots:${columns}`}>
					{entry.data.gallery.map((shot) => (
						<figure class="case-shot">
							<img
								src={shot.src}
								alt={shot.alt}
								width={shot.width}
								height={shot.height}
								loading="lazy"
								decoding="async"
							/>
							{shot.caption && <figcaption>{shot.caption}</figcaption>}
						</figure>
					))}
					{entry.data.credit && <p class="case-credit">{entry.data.credit}</p>}
				</div>
			) : null
		}

		<div class="case-body">
			<Content />
			{
				entry.data.links.length > 0 && (
					<p class="case-links">
						{entry.data.links.map((link) => (
							<a class="btn" href={link.url} rel="noopener">
								{link.label}
							</a>
						))}
					</p>
				)
			}
		</div>
		</div>

		<nav class="case-nav" aria-label="More work">
			{
				prev.id === next.id ? (
					<a href={`/work/${next.id}/`}>{next.data.title} →</a>
				) : (
					<>
						<a href={`/work/${prev.id}/`}>← {prev.data.title}</a>
						<a href={`/work/${next.id}/`}>{next.data.title} →</a>
					</>
				)
			}
		</nav>
	</article>
</Base>
