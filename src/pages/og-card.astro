---
/**
 * /og-card/ is the source of public/og.jpg, the link preview image used by
 * LinkedIn, Slack, WhatsApp and anything else that reads Open Graph tags.
 *
 * It is a page rather than a hand-drawn image for the same reason the CV is:
 * it reads profile data from src/data/cv.ts, so the preview card cannot end
 * up advertising a role the site no longer claims. Capture it with:
 *
 *   bash scripts/make-og.sh
 *
 * The body is exactly 1200x630, the size every social platform crops to.
 * Nothing here is responsive on purpose, and the route is noindex because it
 * exists only to be screenshotted.
 */
import { award, profile } from '../data/cv';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>Link preview card</title>
		<meta name="robots" content="noindex" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400&display=swap"
			rel="stylesheet"
		/>

		<style>
			/* Same tokens as global.css. Duplicated deliberately: this page is
			   captured on its own and must not depend on the site's cascade. */
			:root {
				--paper: #ffffff;
				--ink: #14202e;
				--accent: #1d5b99;
				--muted: #5b6168;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			/* :root lifts this over Astro's scoped `*` reset, an attribute
			   selector that would otherwise zero the padding. */
			:root body {
				width: 1200px;
				height: 630px;
				background: var(--paper);
				color: var(--ink);
				font-family: 'IBM Plex Sans', system-ui, sans-serif;
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: 72px;
				padding: 72px 80px;
				/* The site's accent rule, as on the award panel. */
				border-top: 12px solid var(--accent);
			}

			.kicker {
				font-size: 26px;
				font-weight: 500;
				color: var(--accent);
				margin-bottom: 28px;
			}

			.name {
				font-size: 100px;
				font-weight: 600;
				line-height: 1;
				letter-spacing: -0.03em;
			}

			/* Hairline rule, the site's standard separator. */
			.rule {
				height: 1px;
				background: var(--ink);
				margin: 32px 0 24px;
			}

			.line {
				font-family: 'Source Serif 4', Georgia, serif;
				font-size: 30px;
				line-height: 1.4;
				max-width: 30ch;
			}

			.url {
				font-size: 22px;
				color: var(--muted);
				font-weight: 500;
				margin-top: 28px;
			}

			/* Portrait treatment copied from the home page: small radius, no frame. */
			.portrait {
				width: 300px;
				height: 375px;
				object-fit: cover;
				border-radius: 8px;
				display: block;
			}
		</style>
	</head>

	<body>
		<div>
			<p class="kicker">{profile.role}</p>
			<h1 class="name">Javier<br />Arévalo</h1>
			<div class="rule"></div>
			<p class="line">{award.standings.map((row) => `${row.rank} ${row.place}`).join(', ')} at the {award.event}.</p>
			<p class="url">{profile.siteLabel}</p>
		</div>

		<img class="portrait" src="/picture.jpeg" alt="" />
	</body>
</html>
