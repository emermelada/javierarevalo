---
/**
 * Home page: the whole CV in one scroll.
 *
 * Content comes from two places and only two: `src/data/cv.ts` (profile,
 * experience, skills, education and certifications, shared with the printable
 * /cv/ page) and the `work` content collection (one markdown file per case
 * study, ordered by its `order` frontmatter). Adding a file under
 * src/content/work/ is enough to get a new card + case page.
 *
 * The contact section lives in the Base layout (it doubles as the footer
 * on every page).
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { about, certs, education, experience, facts, nextStop, pitch, skills } from '../data/cv';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [lead, ...rest] = pitch;

/**
 * Index numbering. A normal entry takes the next whole number; an entry
 * flagged `sub: true` hangs off the one above it as `NN.1`, which is how the
 * desk and FocusReef read as one system without either being demoted: same
 * row, same columns, same type size, adjacent numbers.
 */
let major = 0;
let minor = 0;
const numbered = work.map((project) => {
	if (project.data.sub) {
		minor += 1;
	} else {
		major += 1;
		minor = 0;
	}
	const pad = String(major).padStart(2, '0');
	return { project, number: project.data.sub ? `${pad}.${minor}` : pad };
});
---

<Base
	title="Javier Arévalo · Software Developer, Cloud & DevOps"
	description="Javier Arévalo, developer based in Madrid. C# and Azure at Axazure: Dynamics 365 plugins, APIs and automated workloads. Kotlin and Android before that."
>
	<!-- ================= HERO ================= -->
	<section class="hero wrap">
		<p class="hero__kicker">Software Developer · Cloud &amp; DevOps</p>
		<h1 class="hero__name">
			<span class="line">Javier</span>
			<span class="line">Arévalo<span class="accent-dot">.</span></span>
		</h1>

		<div class="hero__grid">
			<p class="hero__pitch"><strong>{lead}</strong> {rest.join(' ')}</p>
			<figure class="hero__portrait">
				<img src="/picture.jpeg" alt="Portrait of Javier Arévalo" width="300" height="375" />
			</figure>
		</div>

		<dl class="facts">
			{
				facts.map((fact) => (
					<div>
						<dt>{fact.label}</dt>
						<dd>{fact.dot && <span class="status-dot">● </span>}{fact.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<!-- ================= ABOUT ================= -->
	<section class="section wrap" id="about" data-reveal>
		<div class="section__head">
			<span class="section__index">01</span>
			<h2 class="section__title">About</h2>
		</div>
		<div class="about">
			<p class="about__lede">{about}</p>
			<aside class="next-card">
				<span class="next-card__label">{nextStop.label}</span>
				<h3 class="next-card__title">{nextStop.title}</h3>
				<span class="next-card__org">{nextStop.org}</span>
				<span class="next-card__when">{nextStop.when}</span>
			</aside>
		</div>
	</section>

	<!-- ================= WORK ================= -->
	<section class="section wrap" id="work" data-reveal>
		<div class="section__head">
			<span class="section__index">02</span>
			<h2 class="section__title">Work</h2>
		</div>

		<ol class="work-index">
			{
				numbered.map(({ project, number }) => (
					<li class={project.data.sub ? 'work-row work-row--sub' : 'work-row'} data-reveal>
						<p class="work-row__num" aria-hidden="true">{number}</p>

						<div class="work-row__main">
							<h3 class="work-row__title">
								<a href={`/work/${project.id}/`}>{project.data.title}</a>
							</h3>
							<p class="work-row__tagline">{project.data.tagline}</p>
							{project.data.related && (
								<p class="work-row__relation">
									{project.data.related.prefix}{' '}
									<a href={`/work/${project.data.related.slug}/`}>{project.data.related.name}</a>
								</p>
							)}
							<ul class="tags">
								{project.data.stack.map((tech) => (
									<li class="tag">{tech}</li>
								))}
							</ul>
						</div>

						<div class="work-row__meta">
							<p class="work-row__year">{project.data.year}</p>
							<p class={`status status--${project.data.status}`}>
								<span class="status__dot" aria-hidden="true">●</span>
								{project.data.status === 'shipped' ? 'Shipped' : 'In progress'}
							</p>
							{project.data.statusNote && <p class="work-row__note">{project.data.statusNote}</p>}
							<ul class="work-row__links">
								{project.data.links.map((link) => (
									<li>
										<a href={link.url} rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>
									</li>
								))}
								<li>
									<a href={`/work/${project.id}/`}>Read the case <span aria-hidden="true">→</span></a>
								</li>
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<!-- ================= EXPERIENCE ================= -->
	<section class="section wrap" id="experience" data-reveal>
		<div class="section__head">
			<span class="section__index">03</span>
			<h2 class="section__title">Experience</h2>
		</div>

		<div class="entries">
			{
				experience.map((job) => (
					<article class="entry">
						<p class="entry__when">{job.when}</p>
						<div>
							<h3 class="entry__role">{job.role}</h3>
							<p class="entry__org">{job.org}</p>
							<ul class="entry__points">
								{job.points?.map((point) => <li>{point}</li>)}
							</ul>
							<ul class="tags">
								{job.tags?.map((tag) => (
									<li class={tag.key ? 'tag tag--key' : 'tag'}>{tag.label}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- ================= SKILLS ================= -->
	<section class="section wrap" id="skills" data-reveal>
		<div class="section__head">
			<span class="section__index">04</span>
			<h2 class="section__title">Skills</h2>
		</div>

		<div class="skill-cols">
			{
				skills.map((group) => (
					<div class="skill-group">
						<h3>{group.title}</h3>
						<p>{group.items}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- ================= EDUCATION & CERTIFICATIONS ================= -->
	<section class="section wrap" id="education" data-reveal>
		<div class="section__head">
			<span class="section__index">05</span>
			<h2 class="section__title">Education</h2>
		</div>

		<div class="entries">
			{
				education.map((step) => (
					<article class="entry">
						<p class="entry__when">{step.when}</p>
						<div>
							<h3 class="entry__role">{step.role}</h3>
							<p class="entry__org">{step.org}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="section__head section__head--sub">
			<span class="section__index">05.1</span>
			<h2 class="section__title section__title--sub">Certifications</h2>
		</div>

		<div class="certs">
			{
				certs.map((cert) =>
					cert.url ? (
						<a class="cert cert--badge" href={cert.url} rel="noopener">
							<span class="cert__name">{cert.name}</span>
							<span class="cert__issuer">{cert.issuer}</span>
							<span class="cert__verify">Verify credential →</span>
						</a>
					) : (
						<div class="cert">
							<span class="cert__name">{cert.name}</span>
							<span class="cert__issuer">{cert.issuer}</span>
						</div>
					)
				)
			}
		</div>
	</section>
</Base>
